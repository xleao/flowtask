# Copiar a .env y ajustar. Todas tienen valor por defecto en app/core/config.py.

# development | production | test  (production exige hosts/CORS explícitos y PostgreSQL)
ENVIRONMENT=development

# Base de datos: el mismo código funciona con cualquiera de las dos. Deja UNA línea activa.
# SQLite (por defecto): no requiere instalar nada; crea backend/flowtask.db.
DATABASE_URL=sqlite:///./flowtask.db
# PostgreSQL: formato postgresql+psycopg://usuario:clave@host:puerto/base
# DATABASE_URL=postgresql+psycopg://flowtask:flowtask@localhost:5432/flowtask
# PostgreSQL: corta consultas colgadas. SQLite: espera máxima de una escritura concurrente.
DB_STATEMENT_TIMEOUT_MS=5000

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Hosts aceptados en la cabecera Host (en producción: el dominio real)
ALLOWED_HOSTS=*

RATE_LIMIT=120/minute
RATE_LIMIT_ENABLED=true
# memory:// cuenta por proceso; con varios workers usar redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# Aplica migraciones + categorías base al arrancar (lo mismo que `python seed.py`)
INIT_DB_ON_STARTUP=true

LOG_LEVEL=INFO
# text (legible) | json (una línea por evento, para producción)
LOG_FORMAT=text
